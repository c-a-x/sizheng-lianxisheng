/* 章节练习 · 目录清单 */

.page {
    min-height: 100vh;
    padding: 30rpx 30rpx 44rpx;
}

.header {
    display: flex;
    padding: 4rpx 0 20rpx;
    flex-direction: column;
    border-bottom: 8rpx solid var(--accent);
}

.header-title {
    color: var(--ink);
    font-size: 40rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.header-subtitle {
    margin-top: 6rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 19rpx;
    line-height: 1.7;
}

.chapter-list {
    display: flex;
    flex-direction: column;
}

.chapter-card {
    margin: 0;
    padding: 20rpx 0 18rpx;
    border: 0;
    border-bottom: 2rpx solid var(--line);
    border-radius: 0;
    background: transparent;
}

.chapter-top {
    display: flex;
    align-items: baseline;
}

.chapter-label {
    display: flex;
    min-width: 44rpx;
    align-items: center;
    flex-shrink: 0;
    background: transparent;
    color: var(--ink-3);
    font-size: 22rpx;
    font-weight: 400;
}

.chapter-copy {
    display: flex;
    margin-left: 10rpx;
    flex: 1;
    flex-direction: column;
    min-width: 0;
}

.chapter-name {
    color: var(--ink);
    font-size: 27rpx;
    font-weight: 600;
    line-height: 1.5;
}

.chapter-count {
    margin-top: 2rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 18rpx;
}

.chapter-arrow {
    margin-left: 10rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 26rpx;
    line-height: 1;
}

.chapter-progress {
    display: flex;
    margin-top: 12rpx;
    align-items: center;
}

.chapter-progress .progress-track {
    flex: 1;
    height: 4rpx;
}

.progress-text {
    width: 72rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 18rpx;
    text-align: right;
}

.source-note {
    padding: 24rpx 8rpx 0;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 19rpx;
    text-align: center;
}
