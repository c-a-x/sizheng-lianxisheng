/* 我的 · 偏好与档案 */

.page {
    min-height: 100vh;
    padding: 30rpx 30rpx 44rpx;
}

.page-header {
    display: flex;
    padding: 4rpx 0 20rpx;
    flex-direction: column;
    border-bottom: 8rpx solid var(--accent);
}

.page-eyebrow {
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 18rpx;
    letter-spacing: 3rpx;
}

.page-title {
    margin-top: 6rpx;
    color: var(--ink);
    font-size: 42rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.page-subtitle {
    margin-top: 4rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 19rpx;
}

/* 提示：定理框 */
.notice-card {
    display: flex;
    margin-top: 20rpx;
    padding: 14rpx 16rpx;
    align-items: flex-start;
    border: 0;
    border-left: 6rpx solid var(--accent);
    background: var(--surface-2);
}

.notice-mark {
    display: none;
}

.notice-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.notice-title {
    color: var(--ink);
    font-size: 22rpx;
    font-weight: 600;
}

.notice-text {
    margin-top: 4rpx;
    color: var(--ink-2);
    font-size: 20rpx;
    line-height: 1.7;
}

/* 外观设置 */
.setting-card {
    margin-top: 20rpx;
    padding: 20rpx 20rpx 22rpx;
    border-radius: 2rpx;
}

.setting-title {
    display: block;
    padding-left: 10rpx;
    border-left: 6rpx solid var(--accent);
    color: var(--ink);
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
    line-height: 1.3;
}

.setting-title-gap {
    margin-top: 24rpx;
    padding-top: 22rpx;
    border-top: 2rpx solid var(--line);
}

.setting-hint {
    display: block;
    margin-top: 10rpx;
    padding-left: 16rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 19rpx;
}

.chip-row {
    display: flex;
    margin-top: 14rpx;
    flex-wrap: wrap;
}

.chip {
    display: flex;
    min-width: 104rpx;
    height: 60rpx;
    margin: 0 10rpx 8rpx 0;
    padding: 0 14rpx;
    align-items: center;
    justify-content: center;
    border: 2rpx solid var(--line-2);
    border-radius: 2rpx;
    background: var(--surface);
}

.chip-active {
    border-color: var(--accent);
    background: var(--accent-soft);
}

.chip-hover {
    opacity: 0.65;
}

.chip-name {
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: 22rpx;
}

.chip-active .chip-name {
    color: var(--accent);
    font-weight: 600;
}

/* 效果预览：示例块 */
.preview-card {
    margin-top: 18rpx;
    padding: 16rpx 16rpx 18rpx;
    border-left: 6rpx solid var(--line-2);
    background: var(--surface-2);
}

.preview-label {
    display: block;
    margin-bottom: 8rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 17rpx;
    letter-spacing: 2rpx;
}

.preview-card .question-text {
    display: block;
    color: var(--ink);
    line-height: 1.9;
}

.preview-card .option-text {
    display: block;
    margin-top: 8rpx;
    color: var(--ink-2);
    line-height: 1.75;
}

/* 统计：三线表 */
.summary-card {
    margin-top: 20rpx;
    padding: 20rpx 0 16rpx;
    border: 0;
    border-top: 2rpx solid var(--line-2);
    border-bottom: 2rpx solid var(--line-2);
    border-radius: 0;
    background: transparent;
}

.summary-grid {
    display: flex;
}

.summary-item {
    display: flex;
    flex: 1;
    align-items: center;
    flex-direction: column;
}

.summary-value {
    color: var(--ink);
    font-size: 34rpx;
    font-weight: 700;
    line-height: 1.2;
}

.summary-label {
    margin-top: 2rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 18rpx;
}

.summary-footer {
    display: flex;
    margin-top: 18rpx;
    padding-top: 14rpx;
    align-items: center;
    border-top: 2rpx solid var(--line);
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 18rpx;
}

.summary-flags {
    display: flex;
    margin-left: auto;
}

/* 操作卡 */
.action-card {
    margin-top: 20rpx;
    padding: 4rpx 20rpx 20rpx;
    border-radius: 2rpx;
}

.action-block {
    display: flex;
    padding: 20rpx 0 4rpx;
    flex-direction: column;
}

.action-title {
    color: var(--ink);
    font-size: 24rpx;
    font-weight: 600;
}

.action-description {
    margin-top: 6rpx;
    color: var(--ink-3);
    font-size: 20rpx;
    line-height: 1.7;
}

.action-button {
    margin-top: 18rpx;
    width: 100%;
}

.action-divider {
    height: 2rpx;
    margin: 16rpx 0 0;
    background: var(--line);
}

.privacy-note {
    margin-top: 12rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 18rpx;
    line-height: 1.7;
}

/* 回滚点 */
.rollback-box {
    display: flex;
    margin-top: 16rpx;
    padding: 14rpx 16rpx;
    align-items: center;
    border-left: 6rpx solid var(--warn);
    background: var(--warn-soft);
}

.rollback-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
}

.rollback-title {
    color: var(--warn);
    font-size: 21rpx;
    font-weight: 600;
}

.rollback-text {
    margin-top: 2rpx;
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: 18rpx;
}

.rollback-action {
    margin-left: 12rpx;
    padding: 8rpx 14rpx;
    border: 2rpx solid var(--warn);
    border-radius: 2rpx;
    background: transparent;
    color: var(--warn);
    font-family: var(--font-sans);
    font-size: 19rpx;
    white-space: nowrap;
}

/* 记录 */
.record-card {
    margin-top: 20rpx;
    padding: 2rpx 20rpx;
    border-radius: 2rpx;
}

.record-row {
    display: flex;
    padding: 16rpx 0;
    align-items: center;
    justify-content: space-between;
}

.record-row + .record-row {
    border-top: 2rpx dashed var(--line);
}

.record-label {
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 21rpx;
}

.record-value {
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: 21rpx;
}

/* 危险区 */
.danger-card {
    margin-top: 20rpx;
    padding: 20rpx;
    border: 2rpx solid var(--bad-edge);
    border-radius: 2rpx;
    background: transparent;
}

.danger-title {
    display: block;
    color: var(--bad);
    font-size: 24rpx;
    font-weight: 600;
}

.danger-description {
    display: block;
    margin-top: 6rpx;
    color: var(--ink-3);
    font-size: 20rpx;
    line-height: 1.7;
}

.danger-button {
    display: flex;
    height: 80rpx;
    margin-top: 18rpx;
    align-items: center;
    justify-content: center;
    border: 2rpx solid var(--bad);
    border-radius: 2rpx;
    background: transparent;
    color: var(--bad);
    font-family: var(--font-sans);
    font-size: 24rpx;
    font-weight: 500;
}


/* 练习开关 */
.switch-row {
    display: flex;
    margin-top: 18rpx;
    padding-top: 16rpx;
    align-items: center;
    justify-content: space-between;
    border-top: 2rpx dashed var(--line);
}

.switch-copy {
    display: flex;
    flex: 1;
    padding-right: 16rpx;
    flex-direction: column;
    min-width: 0;
}

.switch-title {
    color: var(--ink);
    font-size: 23rpx;
    font-weight: 600;
}

.switch-hint {
    margin-top: 2rpx;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 18rpx;
    line-height: 1.6;
}
